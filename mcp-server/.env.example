# production_agent 智能问答后端地址（端口 8000 的 Hono SSE 服务）
AGENT_API_BASE=http://localhost:8000

# 单次问答最长等待毫秒数（默认 2 分钟）
AGENT_API_TIMEOUT_MS=120000

# MCP 服务鉴权用的 Service token / API key
# 必须和企微插件「授权方式 → Service token/API key」里填写的值一致
MCP_API_KEY=your-secret-token

# MCP SSE 服务监听端口（默认 3000）
MCP_PORT=3000

# 企微注入提问者 userid 的请求头名（默认 x-wecom-userid）
USERID_HEADER=x-wecom-userid
