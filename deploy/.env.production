# ============================================
# 中试 AI 助手 — 生产环境变量模板
# ============================================
# 使用方式：
#   1. 复制此文件为 deploy/.env （不入库！）
#   2. 填入真实值
#   3. docker compose 会自动加载
# ============================================

# ── LLM 配置 ──────────────────────
# 供应商: deepseek | openai | qwen | anthropic | google（当前使用阿里云百炼专属端点 bailian）
AI_PROVIDER=bailian
AI_API_KEY=sk-your-real-api-key-here
AI_MODEL=qwen3.8-max
# 模型降级链（同端点同 Key，各模型独立免费额度，额度用尽自动切下一个）
# 顺序：qwen3.8-max → glm-5.2 → qwen3.7-max（deepseek-v4-flash 已弃用，不入链）
AI_MODEL_FALLBACKS=glm-5.2,qwen3.7-max

# ── SQL Server 配置 ───────────────
# ⚠️ 生产环境必须使用只读账号！不要用 sa！
SQL_HOST=172.18.28.88
SQL_PORT=1433
SQL_DB=db1
SQL_USER=comm_plm_prd
SQL_PASSWORD=Gs05eC@5-1

# ── PostgreSQL（Agent 专用看板库）──
# ⚠️ 密码中如有 @ 需转义为 %40
DATABASE_URL=postgresql://kingfa_ai:KingfaAI%402024@172.18.26.74:15432/agent

# ── Web 前端配置 ──────────────────
# Web 调用 Server API 的地址（容器内通过 docker network 通信）
AI_API_URL=http://agent:8000

# ── Server 配置 ───────────────────
PORT=8000
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=4096

# ── MaxKB 接入（OpenAI 兼容接口 /v1/* 鉴权）──
# MaxKB「模型设置」里填的 API Key 就是这个值；未配置时 /v1/* 无鉴权
SYNC_API_KEY=sk-prod-agent-maxkb-2026

# ── 对外开放接口（/open/* Bearer 鉴权）──
# 外部系统调用 GET /open/orders/progress 的 Key；未配置则 /open/* 返回 503（fail-closed）
OPEN_API_KEY=change-me-open-api-key

# ── CORS（生产环境必须设置为实际域名）──
# 示例：CORS_ORIGIN=http://agent.yourcompany.com
CORS_ORIGIN=*
