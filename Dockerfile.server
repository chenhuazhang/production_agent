# ===== Production Agent Server =====
# Hono SSE 服务 + pi_agent 核心
# 使用 tsx 运行时执行 TypeScript（pi_agent workspace 依赖 TS 源码）

FROM node:22-alpine AS base
WORKDIR /app

# 安装编译 better-sqlite3 所需的依赖（web 的 Prisma 用到）
RUN apk add --no-cache python3 make g++

# ── 依赖层 ──────────────────────
FROM base AS deps
COPY package.json package-lock.json ./
COPY pi_agent/agent/package.json pi_agent/agent/
COPY server/package.json server/

# 安装全部依赖（含 devDependencies，tsx 需要）
RUN npm ci --workspaces --include-workspace-root

# ── 运行层 ──────────────────────
FROM base AS runner
WORKDIR /app

# 从 deps 层复制 node_modules
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/pi_agent/agent/node_modules ./pi_agent/agent/node_modules
COPY --from=deps /app/server/node_modules ./server/node_modules

# 复制源码
COPY pi_agent/ ./pi_agent/
COPY server/ ./server/

# AGENTS.md = Agent 系统提示（角色定位/意图路由/能力边界），运行期由框架从此目录向上加载
# 若不复制，容器内 cwd=/app 找不到该文件，Agent 会丢失全部行为规范
COPY AGENTS.md ./

# 自定义模型注册表（bailian provider + qwen3.8-max/glm-5.2/qwen3.7-max）
# 首次创建 agent-sessions 卷时 Docker 会把镜像内 /app/.pi 的内容复制进卷，
# 因此新部署无需再手工 docker cp；卷已存在时仍需 docker cp 覆盖。
COPY deploy/models.json ./.pi/agent/models.json

# 环境
ENV NODE_ENV=production
ENV PORT=8000
ENV NODE_OPTIONS="--max-old-space-size=4096"

EXPOSE 8000

# 健康检查（Alpine 无 wget，用 Node.js 实现）
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8000/health',r=>{process.exit(r.statusCode===200?0:1)})"

CMD ["npx", "tsx", "server/src/index.ts"]
