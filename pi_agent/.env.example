# ===== AI 模型配置 =====
# 供应商：deepseek | openai | qwen | anthropic | google 等（pi-ai 支持 20+）
# 自定义供应商（如 bailian/阿里云百炼）需在 ~/.pi/agent/models.json 中定义
AI_PROVIDER=bailian
AI_API_KEY=your-api-key
# 主模型（按 provider 而定），当前使用阿里云百炼 Qwen3.8-Max
AI_MODEL=qwen3.8-max
# 模型降级链（同端点同 Key，各模型独立免费额度，额度用尽自动切下一个）
# 顺序：qwen3.8-max → glm-5.2 → qwen3.7-max（deepseek-v4-flash 已弃用，不入链）
AI_MODEL_FALLBACKS=glm-5.2,qwen3.7-max

# 可选：自定义 OpenAI 兼容端点（用于通义/智谱等兼容服务）
# 注意：AI_BASE_URL 不在此项目代码中直接使用。
# 自定义端点请通过 ~/.pi/agent/models.json 配置，例：
# {
#   "providers": {
#     "bailian": {
#       "baseUrl": "https://llm-e4vqdf5des2wlxkk.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
#       "api": "openai-completions",
#       "apiKey": "BAILIAN_API_KEY",
#       "models": [{ "id": "qwen3.8-max", "api": "openai-completions", "reasoning": true }]
#     }
#   }
# }

# ===== 服务端口 =====
PORT=8000

# ===== SQL Server（中试生产管理库） =====
# query_order_progress 工具直连此库查询真实进度
SQL_HOST=your-sqlserver-host
SQL_PORT=1433
SQL_DB=your-database
SQL_USER=sa
SQL_PASSWORD=your-password

# ===== MaxKB 接入（OpenAI 兼容接口 /v1/* 鉴权） =====
# MaxKB 以 OpenAI 兼容模型调用 production-agent 时，用此 Key 做 Bearer 鉴权。
# MaxKB 侧「API Key」填相同值。未配置时 /v1/* 不鉴权（仅限内网调试）。
# /v1 按模型名分流业务范围（多智能体共用此 Key）：
#   production-agent       = 全部 5 类
#   production-agent-gz    = 仅 广州送样&小订单
#   production-agent-main  = 广州工艺实验 / 小试 / 上海工艺实验 / OA辅助单
SYNC_API_KEY=sk-prod-agent-maxkb-2026

# ===== 对外开放接口（/open/* 鉴权） =====
# 外部系统调用 GET /open/orders/progress（查订单进度，结构化 JSON）时用此 Key 做 Bearer 鉴权。
# 与 SYNC_API_KEY 相互独立（不同信任域，任一 key 泄露不影响另一个）。
# ⚠️ 未配置时 /open/* 返回 503（fail-closed），不会静默放行。
OPEN_API_KEY=sk-prod-agent-open-2026
